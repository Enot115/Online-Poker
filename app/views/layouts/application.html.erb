<!DOCTYPE html>
<html lang="ru">
  <head>
    <title><%= content_for?(:title) ? yield(:title) : "Лобби" %> · MathPoker</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  </head>
  <body class="club-shell <%= "lobby-shell" if controller_name == "home" %>">
    <header class="app-header">
      <div class="header-inner">
        <%= link_to root_path, class: "brand" do %>
          <span class="brand-mark" aria-hidden="true">♠</span>
          <span>MathPoker</span>
        <% end %>
        <nav class="primary-nav" aria-label="Основная навигация">
          <%= link_to "Лобби", root_path, class: (current_page?(root_path) ? "nav-item is-active" : "nav-item") %>
          <%= link_to "Заработать фишки", earn_chips_path, class: (current_page?(earn_chips_path) ? "nav-item is-active" : "nav-item") %>
          <%= link_to "Профиль", profile_path, class: (current_page?(profile_path) ? "nav-item is-active" : "nav-item") %>
        </nav>
        <div class="header-account">
          <div class="header-balance">
            <span class="balance-chip" aria-hidden="true">◈</span>
            <span><strong><%= logged_in? ? current_user.chip_balance : "—" %></strong><small>фишек</small></span>
          </div>
          <% if logged_in? %>
            <%= link_to current_user.name, profile_path, class: "account-name" %>
            <%= button_to "Выйти", logout_path, method: :delete, class: "button button-quiet button-small" %>
          <% else %>
            <%= link_to "Войти", login_path, class: "nav-link" %>
            <%= link_to "Регистрация", registration_path, class: "button button-small" %>
          <% end %>
        </div>
      </div>
    </header>

    <main class="page-shell page-shell-wide">
      <% if notice %><p class="flash flash-notice"><%= notice %></p><% end %>
      <% if alert %><p class="flash flash-alert"><%= alert %></p><% end %>
      <%= yield %>
    </main>
  </body>
</html>
