<% content_for :title, "Лобби" %>

<section class="lobby-heading">
  <div>
    <p class="eyebrow">ЛОББИ · HOLDEM NO-LIMIT</p>
    <h1>Столы <span>ждут.</span></h1>
    <p class="screen-lead">Выберите игру и присоединяйтесь к раздаче.</p>
  </div>
  <div class="lobby-player-status">
    <span class="status-line <%= "status-muted" unless logged_in? %>"><span class="status-dot"></span><%= logged_in? ? "Вы авторизованы" : "Вы не вошли в аккаунт" %></span>
    <% unless logged_in? %>
      <%= link_to "Войти, чтобы сохранить прогресс", login_path, class: "text-link" %>
    <% end %>
  </div>
</section>

<div class="lobby-grid">
  <section class="lobby-main" aria-labelledby="tables-title">
    <div class="section-heading">
      <div><p class="eyebrow">СЕЙЧАС ИГРАЮТ</p><h2 id="tables-title">Открытые столы <span class="live-count"><%= @tables.size %></span></h2></div>
    </div>

    <div class="table-list">
      <% preview_themes = %w[green blue rust] %>
      <% preview_suits = %w[♠ ♦ ♥] %>
      <% @tables.each_with_index do |table, index| %>
        <% seated_count = @seat_counts.fetch(table.id, 0) %>
        <% already_seated = @current_table_ids.include?(table.id) %>
        <article class="lobby-table <%= "lobby-table-featured" if index.zero? %>">
          <div class="table-preview table-preview-<%= preview_themes[index % preview_themes.length] %>"><span class="preview-suit"><%= preview_suits[index % preview_suits.length] %></span><span class="preview-name"><%= table.name.upcase %></span></div>
          <div class="lobby-table-info"><div class="table-title-row"><h3><%= table.name %></h3><span class="tag <%= seated_count >= table.max_players ? "tag-waiting" : "tag-open" %>"><%= seated_count >= table.max_players ? "Мест нет" : "Открыт" %></span></div><p>Холдем без лимита</p><div class="table-meta"><span><i class="seat-dots"><%= "●" * seated_count %><%= "○" * (table.max_players - seated_count) %></i><%= seated_count %> / <%= table.max_players %> мест</span><span>Блайнды <b><%= table.small_blind %> / <%= table.big_blind %></b></span></div></div>
          <div class="lobby-table-action"><div class="buy-in"><small>Вход</small><strong><%= table.buy_in %> <i>◈</i></strong></div><%= link_to(already_seated ? "Вернуться" : "К столу", table_path(table), class: "button button-small #{index.zero? ? "" : "button-outline"}") %></div>
        </article>
      <% end %>
      <% if @tables.empty? %>
        <p class="lobby-empty">Сейчас нет открытых столов. Попробуйте зайти позже.</p>
      <% end %>
    </div>
    <div class="lobby-footnote"><span class="status-dot"></span> Все столы используют только игровые фишки. Денежных ставок нет.</div>
  </section>

  <aside class="lobby-rail">
    <section class="earn-card">
      <div class="earn-card-top"><span class="earn-icon" aria-hidden="true">＋</span><span class="tag tag-light">ЕЖЕДНЕВНО</span></div>
      <p class="eyebrow">НЕ ХВАТАЕТ ФИШЕК?</p><h2>Решите пример.<br>Продолжайте игру.</h2>
      <p>Правильный ответ пополнит игровой баланс.</p>
      <div class="earn-reward"><span>Награда за задачу</span><strong>+<%= @challenge&.reward_chips || 0 %> <i>◈</i></strong></div>
      <%= link_to "Перейти к задаче", earn_chips_path, class: "button button-light button-wide" %>
      <div class="progress-label"><span>Сегодняшняя задача</span><span><%= @challenge_completed ? "1 / 1" : "0 / 1" %></span></div><div class="progress-track"><span class="<%= "is-complete" if @challenge_completed %>"></span></div>
    </section>

    <section class="quick-profile">
      <div class="quick-profile-head"><div class="avatar avatar-green"><%= logged_in? ? current_user.name.first.upcase : "Г" %></div><div><h3><%= logged_in? ? current_user.name : "Гость" %></h3><p><%= logged_in? ? "Начинающий игрок" : "Профиль игрока" %></p></div></div>
      <div class="quick-stats"><div><strong><%= @table_visit_count %></strong><span>Посещений столов</span></div><div><strong><%= logged_in? ? current_user.chip_balance : "—" %></strong><span>Фишек</span></div></div>
      <%= link_to "Открыть профиль", profile_path, class: "profile-link" %>
    </section>
  </aside>
</div>
