<% content_for :title, @table.name %>

<div class="screen-topline"><%= link_to "← Лобби", root_path, class: "back-link" %><span class="prototype-label"><span></span> TEXAS HOLD’EM</span></div>
<section class="table-page-heading">
  <div><p class="eyebrow">БЕЗ ЛИМИТА</p><h1><%= @table.name %> <span class="table-id">№ <%= @table.id %></span></h1></div>
  <div class="table-page-stats"><span>Блайнды<strong><%= @table.small_blind %> / <%= @table.big_blind %></strong></span><span>Игроки<strong><%= @seats.size %> из <%= @table.max_players %></strong></span><span><%= @current_seat ? "Ваш стек" : "Бай-ин" %><strong><%= @current_seat ? @current_seat.stack : @table.buy_in %> ◈</strong></span></div>
</section>
<%= turbo_stream_from "poker_table_#{@table.id}_user_#{current_user.id}" if @current_seat %>
<%= render "game_view", table: @table, seats: @seats, hand: @hand, current_user: current_user %>