<% content_for :title, "Профиль игрока" %>

<div class="screen-topline"><%= link_to "← Лобби", root_path, class: "back-link" %><span class="prototype-label"><span></span> ПРОФИЛЬ ИГРОКА</span></div>
<section class="profile-hero">
  <div class="profile-identity"><div class="profile-avatar"><%= logged_in? ? current_user.name.first.upcase : "Г" %><span></span></div><div><p class="eyebrow">ИГРОК · С ОКТЯБРЯ 2026</p><h1><%= logged_in? ? current_user.name : "Гость" %></h1><p class="profile-email"><%= logged_in? ? current_user.email : "Войдите, чтобы сохранить прогресс" %></p></div></div>
  <div class="level-block"><div class="level-label"><span>УРОВЕНЬ 04</span><strong>1 280 <small>/ 2 000 XP</small></strong></div><div class="level-track"><i></i></div><span>До следующего уровня осталось 720 XP</span></div>
</section>

<nav class="profile-tabs" aria-label="Разделы профиля"><a href="#overview" class="is-active">Обзор</a><a href="#activity">Активность</a><a href="#account">Аккаунт</a></nav>
<section id="overview" class="profile-overview">
  <div class="profile-main-column">
    <div class="profile-stat-grid"><article class="stat-card"><span class="stat-icon stat-icon-green">♧</span><span>Сыграно раздач</span><strong>128</strong><small>за всё время</small></article><article class="stat-card"><span class="stat-icon stat-icon-coral">↗</span><span>Победы</span><strong>42</strong><small>33% от раздач</small></article><article class="stat-card"><span class="stat-icon stat-icon-yellow">◈</span><span>Лучший выигрыш</span><strong>1 840</strong><small>игровых фишек</small></article></div>
    <section id="activity" class="profile-section"><div class="section-heading"><div><p class="eyebrow">ПОСЛЕДНИЕ РЕЗУЛЬТАТЫ</p><h2>Активность</h2></div><a href="#activity" class="text-link">Вся история →</a></div><div class="activity-list"><div class="activity-row"><span class="activity-symbol activity-win">↗</span><span><strong>Победа за столом «Тёплый стол»</strong><small>Сегодня, 14:32 · 12 раздач</small></span><b class="positive-value">+320 <i>◈</i></b></div><div class="activity-row"><span class="activity-symbol activity-task">✓</span><span><strong>Решена задача дня</strong><small>Сегодня, 14:10 · Награда</small></span><b class="positive-value">+250 <i>◈</i></b></div><div class="activity-row"><span class="activity-symbol activity-game">♠</span><span><strong>Раздача за столом «После работы»</strong><small>Вчера, 20:18 · 8 раздач</small></span><b class="negative-value">−80 <i>◈</i></b></div></div></section>
  </div>
  <aside class="profile-side-column"><section class="profile-balance"><p class="eyebrow">ИГРОВОЙ БАЛАНС</p><strong>2 450 <i>◈</i></strong><span>фишек</span><%= link_to "Заработать фишки", earn_chips_path, class: "button button-light button-wide" %></section><section id="account" class="account-panel"><div class="panel-heading"><h2>Аккаунт</h2><span class="tag tag-open">Активен</span></div><div class="account-detail"><span>Имя игрока</span><b><%= logged_in? ? current_user.name : "Гость" %></b></div><div class="account-detail"><span>Email</span><b><%= logged_in? ? current_user.email : "Не указан" %></b></div><div class="account-detail"><span>Статус</span><b><%= logged_in? ? "Авторизован" : "Гостевой просмотр" %></b></div><% unless logged_in? %><%= link_to "Войти или создать аккаунт", login_path, class: "text-link" %><% end %></section></aside>
</section>