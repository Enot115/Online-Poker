<% content_for :title, "Профиль игрока" %>

<div class="screen-topline"><%= link_to "← Лобби", root_path, class: "back-link" %><span class="prototype-label"><span></span> ПРОФИЛЬ ИГРОКА</span></div>
<section class="profile-hero">
  <div class="profile-identity"><div class="profile-avatar"><%= logged_in? ? current_user.name.first.upcase : "Г" %><span></span></div><div><p class="eyebrow">ИГРОК<%= " · С #{current_user.created_at.strftime("%d.%m.%Y")}" if logged_in? %></p><h1><%= logged_in? ? current_user.name : "Гость" %></h1><p class="profile-email"><%= logged_in? ? current_user.email : "Войдите, чтобы сохранить прогресс" %></p></div></div>
  <div class="level-block"><div class="level-label"><span>ИГРОВОЙ БАЛАНС</span><strong><%= logged_in? ? current_user.chip_balance : "—" %> <small>фишек</small></strong></div><span>Фишки можно использовать для входа за стол.</span></div>
</section>

<nav class="profile-tabs" aria-label="Разделы профиля"><a href="#overview" class="is-active">Обзор</a><a href="#activity">Активность</a><a href="#account">Аккаунт</a></nav>
<section id="overview" class="profile-overview">
  <div class="profile-main-column">
    <div class="profile-stat-grid"><article class="stat-card"><span class="stat-icon stat-icon-green">♧</span><span>Посещений столов</span><strong><%= @table_visit_count %></strong><small>всего входов</small></article><article class="stat-card"><span class="stat-icon stat-icon-coral">✓</span><span>Задач решено</span><strong><%= @challenge_completions.size %></strong><small>получено наград</small></article><article class="stat-card"><span class="stat-icon stat-icon-yellow">◈</span><span>Награды за задачи</span><strong><%= @earned_chips %></strong><small>игровых фишек</small></article></div>
    <section id="activity" class="profile-section"><div class="section-heading"><div><p class="eyebrow">ПОСЛЕДНИЕ ДЕЙСТВИЯ</p><h2>Активность</h2></div></div>
      <% if @activity.any? %>
        <div class="activity-list"><% @activity.each do |item| %><div class="activity-row"><span class="activity-symbol <%= item.is_a?(ChallengeCompletion) ? "activity-task" : "activity-game" %>"><%= item.is_a?(ChallengeCompletion) ? "✓" : "♠" %></span><span><strong><%= item.is_a?(ChallengeCompletion) ? "Решена задача «#{item.daily_challenge.title}»" : "#{item.left_at? ? "Выход из-за стола" : "Вход за стол"} «#{item.poker_table.name}»" %></strong><small><%= item.created_at.strftime("%d.%m.%Y %H:%M") %></small></span><b class="positive-value"><%= item.is_a?(ChallengeCompletion) ? "+#{item.reward_chips}" : (item.left_at? ? "Вышел" : "За столом") %></b></div><% end %></div>
      <% else %>
        <p class="empty-players">Пока нет действий. Решите задачу или займите место за столом.</p>
      <% end %>
    </section>
  </div>
  <aside class="profile-side-column"><section class="profile-balance"><p class="eyebrow">ИГРОВОЙ БАЛАНС</p><strong><%= logged_in? ? current_user.chip_balance : "—" %> <i>◈</i></strong><span>фишек</span><%= link_to "Заработать фишки", earn_chips_path, class: "button button-light button-wide" %></section><section id="account" class="account-panel"><div class="panel-heading"><h2>Аккаунт</h2><span class="tag <%= logged_in? ? "tag-open" : "tag-waiting" %>"><%= logged_in? ? "Активен" : "Гость" %></span></div><div class="account-detail"><span>Имя игрока</span><b><%= logged_in? ? current_user.name : "Гость" %></b></div><div class="account-detail"><span>Email</span><b><%= logged_in? ? current_user.email : "Не указан" %></b></div><div class="account-detail"><span>Статус</span><b><%= logged_in? ? "Авторизован" : "Гостевой просмотр" %></b></div><% unless logged_in? %><%= link_to "Войти или создать аккаунт", login_path, class: "text-link" %><% end %></section></aside>
</section>